        <fr:title text="Subconjunto multiplicativamente cerrado">Subconjunto multiplicativamente cerrado</fr:title>
        <fr:taxon>Definición</fr:taxon>
        <fr:meta name="sources">
          <fr:link href="/atiyah-macdonald-intro-alg-conm/" title="Introducción al álgebra conmutativa" uri="https://juan-mad.github.io/atiyah-macdonald-intro-alg-conm/" display-uri="atiyah-macdonald-intro-alg-conm" type="local" />
        </fr:meta>
      </fr:frontmatter>
      <fr:mainmatter>
        <html:p>Sea <fr:tex display="inline"><![CDATA[A]]></fr:tex> un <fr:link href="/AC-0002/" title="Anillos" uri="https://juan-mad.github.io/AC-0002/" display-uri="AC-0002" type="local">anillo</fr:link>. Un subconjunto <fr:tex display="inline"><![CDATA[S\subset  A]]></fr:tex> se dice que es <html:em>multiplicativamente cerrado</html:em> si <fr:tex display="inline"><![CDATA[1\in  S]]></fr:tex> y es cerrado respecto a la multiplicación.</html:p>
      </fr:mainmatter>
    </fr:tree>
    <fr:tree show-metadata="false">
      <fr:frontmatter>
        <fr:authors>
          <fr:author>
            <fr:link href="/juanmad/" title="Juan Marcos Arranz Díez" uri="https://juan-mad.github.io/juanmad/" display-uri="juanmad" type="local">Juan Marcos Arranz Díez</fr:link>
          </fr:author>
        </fr:authors>
        <fr:date>
          <fr:year>2025</fr:year>
          <fr:month>10</fr:month>
          <fr:day>3</fr:day>
        </fr:date>
        <fr:source-path>/hdd1/Projects/Forester/forest/trees/algebra/anillos/AC-0019.tree</fr:source-path>

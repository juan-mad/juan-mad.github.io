            </fr:meta>
          </fr:frontmatter>
          <fr:mainmatter>
            <html:p>Un ideal <fr:tex display="inline"><![CDATA[I\subset  A]]></fr:tex> de un <fr:link href="https://juan-mad.github.io/AC-0002S/" type="external">anillo graduado</fr:link> <fr:tex display="inline"><![CDATA[A=\bigoplus _nA_n]]></fr:tex> se dice que es un <html:em>ideal homogéneo</html:em> si <fr:tex display="block"><![CDATA[I = \bigoplus _{n=}^\infty  (I\cap  A_n).]]></fr:tex></html:p>
          </fr:mainmatter>
        </fr:tree>
